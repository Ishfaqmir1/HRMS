/// Pre-defined billing plans with per-employee pricing
model BillingPlan {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  description           String?
  currency              String    @default("INR")
  maxEmployees          Int       @default(25)
  maxStorageGB          Int       @default(5)
  features              Json?
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  stripePriceIdMonthly  String?
  stripePriceIdYearly   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  annualDiscountPercent Int       @default(0)
  includedEmployees     Int       @default(25)
  minMonthlyFee         Float     @default(0)
  pricePerEmployee      Float     @default(0)
  companies             Company[]

  @@map("billing_plans")
}

/// Generated invoices for company billing
model Invoice {
  id                    String            @id @default(uuid())
  companyId             String
  invoiceNumber         String            @unique
  description           String?
  amount                Float
  currency              String            @default("USD")
  status                InvoiceStatus     @default(DRAFT)
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  dueDate               DateTime?
  paidAt                DateTime?
  paidById              String?
  stripeInvoiceId       String?           @unique
  stripePaymentIntentId String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lineItems             InvoiceLineItem[]
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  amount      Float
  type        String?
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// Feature flags that can be toggled per company or globally
model FeatureFlag {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  description  String?
  isGlobal     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  companyFlags CompanyFeatureFlag[]

  @@map("feature_flags")
}

/// Per-company feature flag overrides
model CompanyFeatureFlag {
  id            String      @id @default(uuid())
  companyId     String
  featureFlagId String
  isEnabled     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureFlagId])
  @@index([companyId])
  @@map("company_feature_flags")
}

/// Custom branding settings per company
model CompanyBranding {
  id                  String   @id @default(uuid())
  companyId           String   @unique
  primaryColor        String   @default("#0B6E63")
  secondaryColor      String   @default("#10192B")
  accentColor         String   @default("#4DB6A8")
  logoUrl             String?
  faviconUrl          String?
  companyName         String?
  customDomain        String?
  emailFooter         String?
  signatureImageUrl   String?  /// Uploaded signature image for documents & payslips
  signatureEnabled    Boolean  @default(false)
  signatureTitle      String?  /// e.g. "Authorized Signatory" or "HR Manager"
  companyAddress      String?  /// Full address shown on documents
  companyCity         String?
  companyState        String?
  companyPostalCode   String?
  enabled             Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_branding")
}

/// Per-company Indian statutory compliance configuration (PF, ESI, PT, TDS)
model ComplianceConfig {
  id             String   @id @default(uuid())
  companyId      String   @unique
  enablePf       Boolean  @default(true)
  pfWageCeiling  Int      @default(15000)
  pfEmployeePct  Float    @default(12)
  pfEmployerPct  Float    @default(12)
  enableEsi      Boolean  @default(true)
  esiWageCeiling Int      @default(21000)
  esiEmployeePct Float    @default(0.75)
  esiEmployerPct Float    @default(3.25)
  enablePt       Boolean  @default(true)
  ptState        String   @default("KARNATAKA")
  enableTds      Boolean  @default(true)
  tdsRegime      String   @default("NEW")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("compliance_configs")
}

/// State-wise Professional Tax slabs for Indian statutory compliance
model ProfessionalTaxSlab {
  id            String   @id @default(uuid())
  companyId     String
  state         String
  minSalary     Float    @default(0)
  maxSalary     Float?
  taxAmount     Float
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, state])
  @@map("professional_tax_slabs")
}

