/// Pre-built document letter templates for HR document generation
model DocumentTemplate {
  id          String                  @id @default(uuid())
  companyId   String?
  name        String
  slug        String
  description String?
  category    DocumentTemplateCategory @default(OFFER_LETTER)
  content     String                  /// HTML/Handlebars template content
  docxFileUrl String?                 /// Optional .docx template file path
  variables   Json?                   /// Pre-defined variable list for UI hinting
  isDefault   Boolean                 @default(false)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  company     Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents   GeneratedDocument[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([category])
  @@map("document_templates")
}

/// Generated/output documents (one per employee per generation)
model GeneratedDocument {
  id             String   @id @default(uuid())
  companyId      String
  employeeId     String
  templateId     String
  documentType   DocumentTemplateCategory
  title          String
  fileUrl        String   /// Path/URL to the generated PDF/docx file
  fileType       String   @default("pdf")  /// pdf, docx, html
  fileSize       Int?
  variables      Json?    /// Snapshot of the variable values used at generation time
  metadata       Json?    /// Additional context (reason, notes, etc.)
  generatedById  String?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template       DocumentTemplate @relation(fields: [templateId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([templateId])
  @@index([documentType])
  @@index([generatedAt])
  @@map("generated_documents")
}

model TaxDeclaration {
