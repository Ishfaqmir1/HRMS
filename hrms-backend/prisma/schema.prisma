generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                        String                     @id @default(uuid())
  name                      String
  slug                      String                     @unique
  logoUrl                   String?
  industry                  String?
  size                      String?
  timezone                  String                     @default("UTC")
  locale                    String                     @default("en")
  currency                  String                     @default("USD")
  status                    CompanyStatus              @default(ACTIVE)
  subscriptionPlan          SubscriptionPlan           @default(TRIAL)
  trialEndsAt               DateTime?
  billingEmail              String?
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  billingPlanId             String?
  billingCycle              BillingCycle               @default(MONTHLY)
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  assetAssignments          AssetAssignment[]
  assets                    Asset[]
  attendanceBreaks          AttendanceBreak[]
  attendancePhotos          AttendancePhoto[]
  attendancePolicy          AttendancePolicy?
  attendanceRecords         AttendanceRecord[]
  attendanceRegularizations AttendanceRegularization[]
  attendanceSecurityConfig  AttendanceSecurityConfig?
  attendanceSecurityLogs    AttendanceSecurityLog[]
  auditLogs                 AuditLog[]
  branches                  Branch[]
  billingPlan               BillingPlan?               @relation(fields: [billingPlanId], references: [id])
  branding                  CompanyBranding?
  featureFlags              CompanyFeatureFlag[]
  departments               Department[]
  designations              Designation[]
  complianceConfig          ComplianceConfig?
  documentTemplates        DocumentTemplate[]
  generatedDocuments        GeneratedDocument[]
  employeeDocuments         EmployeeDocument[]
  employeeSalaries          EmployeeSalary[]
  employees                 Employee[]
  faceEnrollments           FaceEnrollment[]
  holidays                  Holiday[]
  interviews                Interview[]
  invoices                  Invoice[]
  jobApplications           JobApplication[]
  jobPostings               JobPosting[]
  leaveBalances             LeaveBalance[]
  leaveRequests             LeaveRequest[]
  leaveTypes                LeaveType[]
  loans                     Loan[]
  payrollRuns               PayrollRun[]
  payslips                  Payslip[]
  qrCodeSessions            QRCodeSession[]
  reimbursementCategories   ReimbursementCategory[]
  reimbursements            Reimbursement[]
  roles                     Role[]
  salaryStructures          SalaryStructure[]
  shifts                    Shift[]
  taxDeclarations           TaxDeclaration[]
  professionalTaxSlabs      ProfessionalTaxSlab[]
  trainingEnrollments       TrainingEnrollment[]
  trainings                 Training[]
  trustedDevices            TrustedDevice[]
  users                     User[]

  @@map("companies")
}

model Branch {
  id                   String              @id @default(uuid())
  companyId            String
  name                 String
  code                 String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  country              String?
  postalCode           String?
  timezone             String?
  isHeadOffice         Boolean             @default(false)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  geoFenceRadiusMeters Int?                @default(500)
  latitude             Float?
  longitude            Float?
  ipAllowlists         BranchIpAllowlist[]
  wifiNetworks         BranchWifiNetwork[]
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments          Department[]
  employees            Employee[]
  holidays             Holiday[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Department {
  id               String       @id @default(uuid())
  companyId        String
  branchId         String?
  name             String
  code             String?
  parentId         String?
  departmentHeadId String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  branch           Branch?      @relation(fields: [branchId], references: [id])
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent           Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children         Department[] @relation("DepartmentHierarchy")
  employees        Employee[]
  jobPostings      JobPosting[]
  teams            Team[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("departments")
}

model Team {
  id           String     @id @default(uuid())
  companyId    String
  departmentId String
  name         String
  teamLeadId   String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employees    Employee[]
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("teams")
}

model Designation {
  id        String     @id @default(uuid())
  companyId String
  title     String
  level     Int?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, title])
  @@index([companyId])
  @@map("designations")
}

model User {
  id                 String         @id @default(uuid())
  companyId          String?
  email              String
  passwordHash       String
  status             UserStatus     @default(INVITED)
  isEmailVerified    Boolean        @default(false)
  lastLoginAt        DateTime?
  mustChangePassword Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  auditLogs          AuditLog[]
  employee           Employee?
  refreshTokens      RefreshToken[]
  userRoles          UserRole[]
  company            Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  companyId       String?
  name            String
  slug            String
  systemRole      SystemRole?
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  module          String
  action          String
  description     String?
  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Employee {
  id                        String                     @id @default(uuid())
  companyId                 String
  userId                    String?                    @unique
  employeeCode              String
  firstName                 String
  lastName                  String
  personalEmail             String?
  workEmail                 String?
  phone                     String?
  gender                    Gender?
  dateOfBirth               DateTime?
  dateOfJoining             DateTime
  employmentType            EmploymentType             @default(FULL_TIME)
  status                    EmployeeStatus             @default(ACTIVE)
  branchId                  String?
  departmentId              String?
  teamId                    String?
  designationId             String?
  shiftId                   String?
  reportingManagerId        String?
  dateOfExit                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  assetAssignments          AssetAssignment[]
  attendanceBreaks          AttendanceBreak[]
  attendancePhotos          AttendancePhoto[]
  attendanceRecords         AttendanceRecord[]
  approvedRegularizations   AttendanceRegularization[] @relation("ApproverRegularizations")
  attendanceRegularizations AttendanceRegularization[]
  attendanceSecurityLogs    AttendanceSecurityLog[]
  documents                 EmployeeDocument[]
  employeeSalaries          EmployeeSalary[]
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department                Department?                @relation(fields: [departmentId], references: [id])
  designation               Designation?               @relation(fields: [designationId], references: [id])
  reportingManager          Employee?                  @relation("ManagerHierarchy", fields: [reportingManagerId], references: [id])
  directReports             Employee[]                 @relation("ManagerHierarchy")
  shift                     Shift?                     @relation(fields: [shiftId], references: [id])
  team                      Team?                      @relation(fields: [teamId], references: [id])
  user                      User?                      @relation(fields: [userId], references: [id])
  faceEnrollments           FaceEnrollment[]
  leaveBalances             LeaveBalance[]
  approvedLeaveRequests     LeaveRequest[]             @relation("ApproverLeaveRequests")
  leaveRequests             LeaveRequest[]             @relation("EmployeeLeaveRequests")
  loans                     Loan[]
  generatedDocuments        GeneratedDocument[]
  payslips                  Payslip[]
  qrCodeSessions            QRCodeSession[]
  reimbursements            Reimbursement[]
  taxDeclarations           TaxDeclaration[]
  trainingEnrollments       TrainingEnrollment[]
  trustedDevices            TrustedDevice[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([departmentId])
  @@index([branchId])
  @@index([companyId, status])
  @@index([companyId, gender])
  @@index([companyId, dateOfJoining])
  @@index([companyId, status, departmentId])
  @@map("employees")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("audit_logs")
}

model Shift {
  id                 String     @id @default(uuid())
  companyId          String
  name               String
  startTime          String
  endTime            String
  breakMinutes       Int        @default(60)
  gracePeriodMinutes Int        @default(0)
  workingDays        Int[]
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  employees          Employee[]
  company            Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("shifts")
}

model Holiday {
  id         String   @id @default(uuid())
  companyId  String
  branchId   String?
  name       String
  date       DateTime
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  branch     Branch?  @relation(fields: [branchId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
  @@index([companyId, date])
  @@map("holidays")
}

model TrustedDevice {
  id          String    @id @default(uuid())
  companyId   String
  employeeId  String
  deviceId    String
  deviceName  String?
  platform    String?
  osVersion   String?
  browserInfo String?
  ipAddress   String?
  isTrusted   Boolean   @default(false)
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, deviceId])
  @@index([companyId])
  @@index([employeeId])
  @@map("trusted_devices")
}

model QRCodeSession {
  id         String    @id @default(uuid())
  companyId  String
  employeeId String
  code       String    @unique
  expiresAt  DateTime
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([code])
  @@map("qr_code_sessions")
}

model FaceEnrollment {
  id           String   @id @default(uuid())
  companyId    String
  employeeId   String
  faceEncoding Json?
  imageUrl     String?
  isActive     Boolean  @default(true)
  enrolledAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([employeeId])
  @@map("face_enrollments")
}

model AttendancePhoto {
  id             String            @id @default(uuid())
  companyId      String
  employeeId     String
  recordId       String?
  photoType      String
  imageUrl       String
  faceMatchScore Float?
  createdAt      DateTime          @default(now())
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record         AttendanceRecord? @relation(fields: [recordId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([recordId])
  @@map("attendance_photos")
}

model AttendanceSecurityConfig {
  id                        String   @id @default(uuid())
  companyId                 String   @unique
  requireTrustedDevice      Boolean  @default(false)
  maxTrustedDevices         Int      @default(3)
  requireWifiVerification   Boolean  @default(false)
  requireIpValidation       Boolean  @default(false)
  requireQrScan             Boolean  @default(false)
  qrCodeRefreshSeconds      Int      @default(45)
  requireFaceVerification   Boolean  @default(false)
  faceMatchThreshold        Float    @default(0.75)
  requireLivenessCheck      Boolean  @default(false)
  enforceDeviceBinding      Boolean  @default(false)
  allowedDevicesPerEmployee Int      @default(2)
  checkLocationIntegrity    Boolean  @default(false)
  detectVpn                 Boolean  @default(false)
  detectNetworkChange       Boolean  @default(false)
  captureAttendancePhoto    Boolean  @default(false)
  strictMode                Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("attendance_security_configs")
}

model BranchWifiNetwork {
  id        String   @id @default(uuid())
  branchId  String
  ssid      String
  bssid     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, ssid])
  @@index([branchId])
  @@index([bssid])
  @@map("branch_wifi_networks")
}

model BranchIpAllowlist {
  id          String   @id @default(uuid())
  branchId    String
  ipAddress   String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, ipAddress])
  @@index([branchId])
  @@map("branch_ip_allowlists")
}

model AttendanceSecurityLog {
  id            String   @id @default(uuid())
  companyId     String
  employeeId    String
  action        String
  status        String
  deviceId      String?
  deviceName    String?
  ipAddress     String?
  userAgent     String?
  latitude      Float?
  longitude     Float?
  accuracy      Float?
  layerResults  Json?
  failureReason String?
  metadata      Json?
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("attendance_security_logs")
}

model AttendancePolicy {
  id                        String   @id @default(uuid())
  companyId                 String   @unique
  name                      String   @default("Default Policy")
  timezone                  String   @default("UTC")

  // Working days (0=Sun, 1=Mon, ..., 6=Sat)
  workingDays               Int[]    @default([1,2,3,4,5])

  // Working hours
  defaultStartTime          String   @default("09:00")
  defaultEndTime            String   @default("18:00")
  dailyWorkingHours         Float    @default(9)
  breakDurationMinutes      Int      @default(60)

  // Grace & late rules
  gracePeriodMinutes        Int      @default(15)
  lateThresholdMinutes      Int      @default(30)
  veryLateThresholdMinutes  Int      @default(60)
  halfDayThresholdMinutes   Int      @default(240)
  minimumWorkingMinutes     Int      @default(480)
  maximumWorkingMinutes     Int      @default(720)

  // Overtime
  enableOvertime            Boolean  @default(true)
  overtimeStartsAfterMinutes Int     @default(540)
  maxOvertimeMinutes        Int      @default(240)

  // Auto-detection flags
  enableAutoLateDetection   Boolean  @default(true)
  enableAutoHalfDay         Boolean  @default(true)
  enableAutoAbsent          Boolean  @default(true)

  // Auto checkout
  enableAutoCheckout        Boolean  @default(true)
  autoCheckoutTime          String   @default("23:59")

  // Remote / flexible
  enableRemoteWork          Boolean  @default(false)
  enableFlexibleShift       Boolean  @default(false)
  enableMultiplePunch       Boolean  @default(false)
  crossMidnightShift        Boolean  @default(false)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

model AttendanceRecord {
  id                String                     @id @default(uuid())
  companyId         String
  employeeId        String
  date              DateTime
  checkIn           DateTime?
  checkOut          DateTime?
  workedMinutes     Int?
  breakMinutes      Int?                       @default(0)
  breakStart        DateTime?
  breakEnd          DateTime?
  overtimeMinutes   Int?                       @default(0)
  lateMinutes       Int?                       @default(0)
  earlyExitMinutes  Int?                       @default(0)
  status            AttendanceStatus           @default(PRESENT)
  source            AttendanceSource           @default(WEB)
  checkInLat        Float?
  checkInLng        Float?
  checkOutLat       Float?
  checkOutLng       Float?
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  photos            AttendancePhoto[]
  breaks            AttendanceBreak[]
  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  regularizations   AttendanceRegularization[]

  @@unique([employeeId, date])
  @@index([companyId])
  @@index([employeeId])
  @@index([date])
  @@index([companyId, date, status])
  @@index([employeeId, date, status])
  @@map("attendance_records")
}

model AttendanceBreak {
  id          String           @id @default(uuid())
  companyId   String
  employeeId  String
  recordId    String
  type        String           @default("BREAK")
  startTime   DateTime
  endTime     DateTime?
  durationMinutes Int?         @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record      AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([employeeId])
  @@map("attendance_breaks")
}



model AttendanceRegularization {
  id                String               @id @default(uuid())
  companyId         String
  employeeId        String
  date              DateTime
  attendanceId      String?
  reason            String
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  requestedStatus   AttendanceStatus?
  notes             String?
  status            RegularizationStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  approvedBy        Employee?            @relation("ApproverRegularizations", fields: [approvedById], references: [id])
  attendance        AttendanceRecord?    @relation(fields: [attendanceId], references: [id])
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("attendance_regularizations")
}

model LeaveType {
  id                  String         @id @default(uuid())
  companyId           String
  name                String
  code                String
  daysPerYear         Float          @default(0)
  isPaid              Boolean        @default(true)
  carryForward        Boolean        @default(false)
  maxCarryForwardDays Float?
  requiresApproval    Boolean        @default(true)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid())
  companyId      String
  employeeId     String
  leaveTypeId    String
  year           Int
  allocated      Float     @default(0)
  used           Float     @default(0)
  carriedForward Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String             @id @default(uuid())
  companyId       String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  approvedBy      Employee?          @relation("ApproverLeaveRequests", fields: [approvedById], references: [id])
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee           @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([employeeId, startDate, endDate])
  @@index([employeeId, status, createdAt])
  @@map("leave_requests")
}

model SalaryStructure {
  id                 String           @id @default(uuid())
  companyId          String
  name               String
  description        String?
  basic              Float            @default(0)
  housingAllowance   Float            @default(0)
  transportAllowance Float            @default(0)
  medicalAllowance   Float            @default(0)
  otherAllowances    Float            @default(0)
  taxPercent         Float            @default(0)
  pensionPercent     Float            @default(0)
  insuranceDeduction Float            @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employeeSalaries   EmployeeSalary[]
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("salary_structures")
}

model EmployeeSalary {
  id                 String           @id @default(uuid())
  companyId          String
  employeeId         String
  structureId        String?
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  basic              Float            @default(0)
  housingAllowance   Float            @default(0)
  transportAllowance Float            @default(0)
  medicalAllowance   Float            @default(0)
  otherAllowances    Float            @default(0)
  taxPercent         Float            @default(0)
  pensionPercent     Float            @default(0)
  insuranceDeduction Float            @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure          SalaryStructure? @relation(fields: [structureId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@map("employee_salaries")
}

model PayrollRun {
  id              String           @id @default(uuid())
  companyId       String
  month           Int
  year            Int
  version         Int              @default(1)
  previousRunId   String?
  status          PayrollRunStatus @default(DRAFT)
  processedById   String?
  processedAt     DateTime?
  totalGross      Float            @default(0)
  totalDeductions Float            @default(0)
  totalNet        Float            @default(0)
  employeeCount   Int              @default(0)
  recalcReason    String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips        Payslip[]
  previousRun     PayrollRun?      @relation("PayrollVersion", fields: [previousRunId], references: [id])
  childRuns       PayrollRun[]     @relation("PayrollVersion")

  @@unique([companyId, month, year, version])
  @@index([companyId])
  @@index([companyId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id                 String        @id @default(uuid())
  companyId          String
  employeeId         String
  runId              String
  previousPayslipId  String?
  basic              Float         @default(0)
  housingAllowance   Float         @default(0)
  transportAllowance Float         @default(0)
  medicalAllowance   Float         @default(0)
  otherAllowances    Float         @default(0)
  overtimePay        Float         @default(0)
  bonus              Float         @default(0)
  grossPay           Float         @default(0)
  taxDeduction       Float         @default(0)
  pensionDeduction   Float         @default(0)
  insuranceDeduction Float         @default(0)
  loanDeduction      Float         @default(0)
  otherDeductions    Float         @default(0)
  totalDeductions    Float         @default(0)
  netPay             Float         @default(0)
  adjustments        Json?
  status             PayslipStatus @default(DRAFT)
  paidAt             DateTime?
  paidById           String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  run                PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  previousPayslip    Payslip?      @relation("PayslipVersion", fields: [previousPayslipId], references: [id])
  revisedPayslips    Payslip[]     @relation("PayslipVersion")

  @@unique([employeeId, runId])
  @@index([companyId])
  @@index([runId])
  @@map("payslips")
}

model Loan {
  id                 String          @id @default(uuid())
  companyId          String
  employeeId         String
  loanType           LoanType        @default(PERSONAL)
  amount             Float
  totalAmount        Float
  interestRate       Float           @default(0)
  repaymentMonths    Int
  monthlyInstallment Float
  purpose            String?
  status             LoanStatus      @default(PENDING)
  approvedById       String?
  approvedAt         DateTime?
  disbursedAt        DateTime?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  repayments         LoanRepayment[]
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("loans")
}

model LoanRepayment {
  id        String    @id @default(uuid())
  loanId    String
  amount    Float
  dueDate   DateTime
  paidAt    DateTime?
  status    String    @default("PENDING")
  notes     String?
  createdAt DateTime  @default(now())
  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_repayments")
}

model ReimbursementCategory {
