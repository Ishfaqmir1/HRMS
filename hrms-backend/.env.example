# ---- App ----
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
DATABASE_URL="postgresql://hrms:hrms_password@localhost:5432/hrms_db?schema=public"

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=10

# ---- Throttling ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Super Admin Seed ----
SUPER_ADMIN_EMAIL=superadmin@hrms.io
SUPER_ADMIN_PASSWORD=ChangeMe123!
