  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, financialYear])
  @@index([companyId])
  @@index([employeeId])
  @@map("tax_declarations")
}

model Asset {
